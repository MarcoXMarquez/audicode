# AudiCode - configuracion de entorno (modo escritorio)
# Copia este archivo a .env (opcional). AudiCode funciona sin .env: el modo
# escritorio (audicode_desktop.py) fija AUTH_ENABLED=false, APP_BIND=127.0.0.1
# y APP_PORT=7000 por su cuenta. Todo lo de abajo es opcional.
# Los nombres ODYSSEUS_* se conservan por herencia del proyecto base.

# ============================================================
# Modelos locales: Ollama / LM Studio
# ============================================================
# Host del LLM local (por defecto: localhost). Se escanean puertos habituales,
# incluido el de Ollama (11434).
# LLM_HOST=localhost
# Hosts adicionales separados por coma (descubrimiento de modelos).
# LLM_HOSTS=otro-host.local

# URL base de Ollama (tambien se acepta OLLAMA_URL). Ej. Ollama por defecto:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# URL de LM Studio:
# LM_STUDIO_URL=http://localhost:1234

# ============================================================
# Proveedores en la nube
# ============================================================
# Solo OPENAI_API_KEY se lee desde el entorno. No commitees claves reales.
# OPENAI_API_KEY=tu_clave_openai
#
# Gemini, Anthropic y demas proveedores de nube NO usan variables de entorno:
# sus claves se configuran desde la interfaz (seccion de proveedores).

# CA extra para proveedores con cadena TLS propia (se suma al bundle del
# sistema; la verificacion sigue activa). Ruta a un PEM.
# LLM_CA_BUNDLE=C:\ruta\a\roots.pem

# ============================================================
# Busqueda web (opcional)
# ============================================================
# SEARXNG_INSTANCE=http://localhost:8080
# TAVILY_API_KEY=
# SERPER_API_KEY=
# DATA_BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_PSE_CX=

# ============================================================
# Datos y base de datos
# ============================================================
# Mueve todo lo que vive en data/ (ajustes, sesiones, BD, adjuntos) a otra ruta:
# ODYSSEUS_DATA_DIR=C:\ruta\a\datos
# DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Servidor y seguridad
# ============================================================
# El modo escritorio ya fuerza estos valores; solo cambialos si ejecutas
# `python app.py` / launcher.py de forma manual.
# AUTH_ENABLED=true
# APP_BIND=127.0.0.1
# APP_PORT=7000
# ALLOWED_ORIGINS=http://localhost:7000
# SECURE_COOKIES=false
# LOCALHOST_BYPASS=false

# ============================================================
# RAG / Embeddings
# ============================================================
# Por defecto se usa fastembed (ONNX local, descarga ~50MB la primera vez).
# EMBEDDING_URL=http://localhost:11434/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=all-minilm:l6-v2
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=

# ChromaDB (servidor HTTP; si no esta disponible se usa busqueda por palabras clave)
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# ============================================================
# Varios
# ============================================================
# Limite de adjuntos del chat en bytes (por defecto 10 MB).
# ODYSSEUS_CHAT_UPLOAD_MAX_BYTES=10485760
# Horas entre limpiezas automaticas (por defecto 24).
# CLEANUP_INTERVAL_HOURS=24
# LOG_LEVEL=INFO

# ============================================================
# Exposición pública (Docker / reverse proxy)
# ============================================================
# Token para crear el primer admin desde fuera de loopback (enviar como
# cabecera X-Setup-Token). Sin él, el setup solo se permite desde 127.0.0.1.
# AUDICODE_SETUP_TOKEN=
# IP del reverse proxy en la que confiar para X-Forwarded-* (nunca "*").
# FORWARDED_ALLOW_IPS=127.0.0.1
# Con AUTH_ENABLED=false la app se niega a arrancar si APP_BIND no es loopback.
