# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Local environment & runtime data
.env
data/*.db
data/*.db-shm
data/*.db-wal
data/*.json
# data/skills/ (bundled skills) stays versioned: only top-level data/*.json is ignored
data/sessions/
data/uploads/
data/logs/
data/personal_docs/
*.log
*.bak

# OS / IDE artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# PyInstaller / Build artifacts
build/
dist/
*.zip
/test_*.py

# Encryption keys and secrets generated at runtime
data/.key
data/.app_key
data/skills/_usage.json
